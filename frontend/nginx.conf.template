# nginx config for the production image (frontend/Dockerfile). It serves the
# built frontend and forwards /api/ to the backend, so the browser only talks
# to this one origin and the backend port never has to be public.
# At startup the nginx image fills in ${BACKEND_UPSTREAM} from the environment
# and writes the result to /etc/nginx/conf.d/default.conf.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's internal DNS. Looking the backend up per request (through the
    # variable below) instead of once at startup keeps /api/ working after the
    # backend container is recreated with a new IP.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        set $backend ${BACKEND_UPSTREAM};
        # /api/token -> /token. With a variable in proxy_pass, nginx doesn't
        # strip the prefix by itself.
        rewrite ^/api/(.*)$ /$1 break;
        # The Host header is left as the upstream's, so the backend still checks
        # the browser's Origin against CORS_ALLOWED_ORIGINS.
        proxy_pass http://$backend;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # nginx's default 1 MB limit would reject saving a large project.
        client_max_body_size 20m;
    }
}
